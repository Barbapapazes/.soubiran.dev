{
  "name": "@soubiran/ui",
  "type": "module",
  "version": "0.8.2",
  "author": "Estéban Soubiran <esteban@soubiran.dev>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/Barbapapazes",
  "homepage": "https://github.com/Barbapapazes/.soubiran.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Barbapapazes/.soubiran.dev"
  },
  "bugs": "https://github.com/Barbapapazes/.soubiran.dev/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "style": "./dist/style.css"
    },
    "./components/*": "./dist/components/*",
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.js"
    },
    "./imports": {
      "types": "./dist/imports.d.mts",
      "import": "./dist/imports.mjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.mts",
      "import": "./dist/resolver.mjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./umami": {
      "types": "./umami.d.ts"
    },
    "./wrapper-classes": {
      "types": "./dist/wrapper-classes.d.ts",
      "import": "./dist/wrapper-classes.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "umami.d.ts"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "tsdown && tsdown -c tsdown.config.node.ts --no-clean"
  },
  "dependencies": {
    "@nuxt/ui": "^4.7.0",
    "@pinia/colada": "^1.2.1",
    "@vue/compiler-sfc": "^3.5.33",
    "@vueuse/core": "^14.3.0",
    "markdown-it-github-alerts": "^1.0.1",
    "motion-v": "^2.2.1",
    "ofetch": "^1.5.1",
    "partysocket": "^1.1.18",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.6",
    "tailwind-variants": "^3.2.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.10",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.79",
    "@tsdown/css": "^0.21.10",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/language-core": "^3.2.7",
    "@vue/tsconfig": "^0.9.1",
    "tsdown": "^0.21.10",
    "typescript": "~5.9.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue": "^7.2.0",
    "vue-tsc": "^3.2.7"
  }
}
