{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "paths": {
      "#build/ui/*": [
        "./node_modules/.nuxt-ui/ui/*"
      ]
    },
    "types": [
      "vite/client",
      "unplugin-icons/types/vue"
    ],
    "allowArbitraryExtensions": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "./umami.d.ts",
    "./typed-router.d.ts",
    "./src/auto-imports.d.ts",
    "./src/components.d.ts",
    "./src/index.ts",
    "./src/main.ts",
    "./src/wrapper-classes.ts",
    "./src/ui.ts",
    "./src/App.vue",
    "./src/vite-env.d.ts",
    "./src/locale/*.ts",
    "./src/types/*.ts",
    "./src/api/**/*.ts",
    "./src/utils/**/*.ts",
    "./src/hooks/**/*.ts",
    "./src/keys/**/*.ts",
    "./src/queries/**/*.ts",
    "./src/pages/**/*.ts",
    "./src/components/**/*.vue",
    "./src/composables/**/*.ts"
  ]
}
